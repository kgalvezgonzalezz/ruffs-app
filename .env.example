# ─────────────────────────────────────────────────────────────
#  RUFFS — variables de entorno
#  Copia este archivo como .env y rellena lo que necesites.
#  El .env nunca se sube a git (está en .gitignore).
# ─────────────────────────────────────────────────────────────

# === Proveedor de IA ===
# Con esta clave, RUFFS crea solo el endpoint de OpenRouter al arrancar
# (también puedes añadirlo a mano en Ajustes → Modelos).
OPENROUTER_API_KEY=
# Modelo por defecto si aún no has elegido ninguno.
RUFFS_DEFAULT_MODEL=deepseek/deepseek-v4-flash

# === Servidor ===
# RUFFS escucha solo en este equipo. Usa 0.0.0.0 únicamente si quieres
# acceder desde otros dispositivos de tu red (y mantén AUTH_ENABLED=true).
APP_BIND=127.0.0.1
APP_PORT=7100
AUTH_ENABLED=true
LOCALHOST_BYPASS=false
SECURE_COOKIES=false

# === Comportamiento de la IA (valores por defecto recomendados) ===
# Continuar sola cuando el modelo se corta por límite de tokens.
RUFFS_AUTO_CONTINUE=true
RUFFS_AUTO_CONTINUE_MAX=4
# Tope de tokens de salida por respuesta (las respuestas más largas se
# completan con la continuación automática).
RUFFS_MAX_OUTPUT_TOKENS=32768
# Rondas máximas del agente antes de pausar y pedirte que continúes.
RUFFS_AGENT_MAX_ROUNDS=200
# Tope de gasto por mensaje en dólares (coste real de OpenRouter); 0 = sin tope.
RUFFS_AGENT_MAX_COST_USD=1.0
# Recordar al modelo qué herramientas ejecutó en turnos anteriores.
RUFFS_TOOL_MEMORY=true
# Caché de prompts en OpenRouter para modelos anthropic/*.
RUFFS_PROMPT_CACHE=true

# === Servidores MCP ===
# Segundos de espera al conectar un servidor (npx/uvx tienen más margen
# porque la primera vez descargan el paquete).
RUFFS_MCP_CONNECT_TIMEOUT=30
RUFFS_MCP_CONNECT_TIMEOUT_LAUNCHER=120

# === Modelos locales (Cookbook, vLLM, llama.cpp) ===
# Desactivados: RUFFS está orientado a APIs en la nube.
RUFFS_ENABLE_LOCAL_MODELS=false

# === Opcionales ===
# Solo si usas un servidor ChromaDB aparte; si no, la memoria vectorial
# funciona embebida en data/chromadb.
# CHROMADB_HOST=localhost
# CHROMADB_PORT=8100
